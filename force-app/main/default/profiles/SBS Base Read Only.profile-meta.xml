<?xml version="1.0" encoding="UTF-8"?>
<Profile xmlns="http://soap.sforce.com/2006/04/metadata">
    <!-- ============================================================
         SBS Base Read Only Profile
         ============================================================
         Purpose: Single minimal-access profile for all SBS users.
         All Create/Edit/Delete/ViewAll/ModifyAll access is stripped.
         Functional access is granted exclusively through Permission
         Sets and Permission Set Groups assigned via UserRole.

         Design Principles:
         - Read-only object access across all business objects
         - No Apex class access (granted via feature permission sets)
         - Tabs set to DefaultOff (not Hidden) so PSG-driven Lightning
           apps control navigation; Hidden cannot be overridden
         - Minimal user permissions for platform functionality
         - No field-level security overrides (defaults apply)
         ============================================================ -->

    <!-- ==================== APPLICATION VISIBILITIES ==================== -->
    <applicationVisibilities>
        <application>standard__LightningService</application>
        <default>true</default>
        <visible>true</visible>
    </applicationVisibilities>
    <applicationVisibilities>
        <application>standard__Service</application>
        <default>false</default>
        <visible>false</visible>
    </applicationVisibilities>
    <applicationVisibilities>
        <application>standard__ServiceConsole</application>
        <default>false</default>
        <visible>false</visible>
    </applicationVisibilities>
    <applicationVisibilities>
        <application>Customer_Digital_Engagement</application>
        <default>false</default>
        <visible>false</visible>
    </applicationVisibilities>
    <applicationVisibilities>
        <application>Pricing_Request</application>
        <default>false</default>
        <visible>false</visible>
    </applicationVisibilities>

    <!-- ==================== APEX CLASS ACCESS ==================== -->
    <!-- All Apex class access is DISABLED at the profile level.
         Feature-based permission sets grant class access as needed.
         This ensures no user has implicit code execution rights
         beyond what their assigned PSG provides. -->

